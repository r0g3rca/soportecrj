<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SoporteCRJ | Sistema D3XD</title>
    <style>
        /* --- ESTILOS GENERALES (CSS) --- */
        :root {
            --primary-color: #0056b3; /* Azul corporativo */
            --secondary-color: #00a8e8;
            --accent-color: #ff9f1c;
            --bg-light: #f4f7f6;
            --text-dark: #333;
            --white: #ffffff;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
            background-color: var(--bg-light);
            color: var(--text-dark);
            line-height: 1.6;
        }

        /* --- HEADER --- */
        header {
            background: var(--primary-color);
            color: var(--white);
            padding: 1rem 0;
            text-align: center;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }

        header h1 { margin: 0; font-size: 1.8rem; }
        header p { margin: 5px 0 0; opacity: 0.9; }

        /* --- CONTENEDOR PRINCIPAL --- */
        .container {
            max-width: 800px;
            margin: 40px auto;
            padding: 20px;
        }

        /* --- TARJETA DEL FORMULARIO --- */
        .card {
            background: var(--white);
            padding: 40px;
            border-radius: 10px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        }

        .card-header { text-align: center; margin-bottom: 30px; }
        .card-header h2 { color: var(--primary-color); }

        /* --- FORMULARIO --- */
        .form-group { margin-bottom: 20px; }
        
        label {
            display: block;
            margin-bottom: 8px;
            font-weight: bold;
            color: #555;
        }

        input, select, textarea {
            width: 100%;
            padding: 12px;
            border: 1px solid #ddd;
            border-radius: 6px;
            font-size: 1rem;
            box-sizing: border-box; /* Asegura que el padding no rompa el ancho */
            transition: border-color 0.3s;
        }

        input:focus, select:focus, textarea:focus {
            border-color: var(--secondary-color);
            outline: none;
        }

        /* Botones de selección de tipo (Radio buttons estilizados) */
        .type-selector {
            display: flex;
            gap: 15px;
            margin-bottom: 20px;
        }

        .radio-label {
            flex: 1;
            text-align: center;
            padding: 15px;
            border: 2px solid #ddd;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s;
        }

        input[type="radio"] { display: none; }

        input[type="radio"]:checked + .radio-label {
            border-color: var(--primary-color);
            background-color: #eef7ff;
            color: var(--primary-color);
            font-weight: bold;
        }

        /* Botón de Enviar */
        .btn-submit {
            background-color: var(--primary-color);
            color: var(--white);
            border: none;
            padding: 15px;
            width: 100%;
            font-size: 1.1rem;
            font-weight: bold;
            border-radius: 6px;
            cursor: pointer;
            transition: background 0.3s;
        }

        .btn-submit:hover { background-color: #004494; }

        /* --- FOOTER --- */
        footer {
            text-align: center;
            padding: 20px;
            color: #777;
            font-size: 0.9rem;
            margin-top: 40px;
        }

        /* Ocultar campo de fecha si no es cita */
        .date-group { display: none; }

        /* Responsivo */
        @media (max-width: 600px) {
            .card { padding: 20px; }
            .type-selector { flex-direction: column; }
        }
    </style>
</head>
<body>

    <header>
        <h1>SoporteCRJ</h1>
        <p>Especialistas en Sistema D3XD</p>
    </header>

    <div class="container">
        <div class="card">
            <div class="card-header">
                <h2>Gestión de Soporte</h2>
                <p>Por favor completa el formulario para ayudarte con tu sistema.</p>
            </div>

            <form id="supportForm">
                
                <label>¿Qué necesitas hoy?</label>
                <div class="type-selector">
                    <label for="type-cita" class="radio-label">
                        <input type="radio" id="type-cita" name="tipo_solicitud" value="Cita Técnica" onclick="toggleDate(true)" checked>
                        📅 Agendar Cita
                    </label>
                    <label for="type-update" class="radio-label">
                        <input type="radio" id="type-update" name="tipo_solicitud" value="Actualización D3XD" onclick="toggleDate(false)">
                        🚀 Actualización D3XD
                    </label>
                </div>

                <div class="form-group">
                    <label for="nombre">Nombre o Empresa</label>
                    <input type="text" id="nombre" name="nombre" placeholder="Ej. Juan Pérez / Comercial ABC" required>
                </div>

                <div class="form-group">
                    <label for="contacto">Teléfono / WhatsApp</label>
                    <input type="tel" id="contacto" name="contacto" placeholder="+58..." required>
                </div>

                <div class="form-group date-group" id="dateGroup" style="display: block;">
                    <label for="fecha">Fecha y Hora preferida</label>
                    <input type="datetime-local" id="fecha" name="fecha">
                </div>

                <div class="form-group">
                    <label for="mensaje">Detalles de la solicitud</label>
                    <textarea id="mensaje" name="mensaje" rows="4" placeholder="Describe brevemente el problema o la versión actual de tu sistema D3XD..."></textarea>
                </div>

                <button type="submit" class="btn-submit">Enviar Solicitud</button>
            </form>
        </div>
    </div>

    <footer>
        <p>&copy; 2024 Soportecrj. Todos los derechos reservados.</p>
        <p>Soporte técnico especializado para sistemas administrativos.</p>
    </footer>

    <script>
        // --- LÓGICA JAVASCRIPT ---

        // Función para mostrar/ocultar el campo de fecha
        function toggleDate(show) {
            const dateGroup = document.getElementById('dateGroup');
            if (show) {
                dateGroup.style.display = 'block';
            } else {
                dateGroup.style.display = 'none';
            }
        }

        // Manejo del envío del formulario (Simulación)
        document.getElementById('supportForm').addEventListener('submit', function(e) {
            e.preventDefault(); // Evita que la página se recargue

            // Aquí capturamos los datos
            const nombre = document.getElementById('nombre').value;
            const tipo = document.querySelector('input[name="tipo_solicitud"]:checked').value;
            
            // Simulación de éxito
            alert(`¡Gracias ${nombre}!\n\nHemos recibido tu solicitud de: ${tipo}.\nNos pondremos en contacto contigo pronto.`);
            
            // Opcional: Limpiar formulario
            // this.reset(); 
        });
    </script>

</body>
</html>
